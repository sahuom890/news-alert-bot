# =====================================================================
# Web Scraper & Discord Alert Bot Environment Configuration
# Copy this file to .env and configure the variables below.
# =====================================================================

# ---------------------------------------------------------------------
# Discord Webhook Configuration
# ---------------------------------------------------------------------
# Provide your Discord Webhook URL. If empty, the bot automatically
# falls back to DRY_RUN mode and prints alerts to console.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# ---------------------------------------------------------------------
# Target & Scraping Configuration
# ---------------------------------------------------------------------
# Target URL (e.g. Hacker News frontpage or /newest)
TARGET_URL=https://news.ycombinator.com/news

# Custom User-Agent header to identify your bot transparently
USER_AGENT=NewsAlertBot/1.0 (+https://github.com/developer/news-alert-bot)

# HTTP Request timeout in seconds
REQUEST_TIMEOUT_SECONDS=15.0

# Retry configuration for network glitches and rate-limits
MAX_RETRIES=3
BACKOFF_FACTOR=2.0

# ---------------------------------------------------------------------
# Pipeline & Filtering Settings
# ---------------------------------------------------------------------
# Interval between scrape passes in daemon mode (in seconds)
POLL_INTERVAL_SECONDS=300

# Maximum number of top stories to inspect per scrape cycle
MAX_ITEMS_PER_RUN=20

# Minimum points/upvotes needed to trigger an alert (0 = all items)
MIN_POINTS_THRESHOLD=50

# ---------------------------------------------------------------------
# Database & Retention
# ---------------------------------------------------------------------
# Path to SQLite database file
DATABASE_PATH=alerts.db

# Days to retain seen records before pruning
CLEANUP_RETENTION_DAYS=30

# ---------------------------------------------------------------------
# Operational Modes
# ---------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Set to True to simulate scraping and formatting without posting to Discord
DRY_RUN=false
